{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "idea-audit attacker result",
  "type": "object",
  "required": ["pass", "findings"],
  "additionalProperties": false,
  "properties": {
    "pass": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary", "evidence"],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
