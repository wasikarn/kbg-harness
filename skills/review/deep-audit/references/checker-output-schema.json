{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "deep-audit checker result",
  "type": "object",
  "required": ["pass", "findings", "scope_ok", "unexpected_files"],
  "additionalProperties": false,
  "properties": {
    "pass": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary", "evidence"],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "scope_ok": {
      "type": "boolean"
    },
    "unexpected_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
